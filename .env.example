# Copia este archivo a .env.local (no se sube a git) y pega la llave real.
# Llave compartida de Groq con la que arrancan todas las cuentas nuevas. Empieza con gsk_
# Se crea en https://console.groq.com/keys
VITE_GROQ_KEY=

# --- Apps conectadas (MCP) -----------------------------------------------------------------------
# Las apps se conectan por el estándar MCP con la autorización OAuth del propio protocolo: no hacen falta
# llaves. Estas variables son opcionales.
# Origen público https donde se sirve SkyOS; permite identificarse con Client ID Metadata Documents.
VITE_APP_ORIGIN=
# Google (Drive, Docs, Gmail, Calendar) no registra clientes al vuelo: crea un cliente OAuth "Aplicación web"
# en https://console.cloud.google.com/apis/credentials con la URL de retorno <origen>/oauth/callback.
# OneDrive sync (optional): Microsoft Entra app registration of type "Single-page application" with
# redirect URI <origin>/oauth/callback and the Files.ReadWrite.AppFolder permission.
VITE_MS_CLIENT_ID=

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
# Puente opcional (carpeta bridge/): solo añade cabeceras CORS para servidores que no aceptan navegadores.
VITE_BRIDGE_URL=
