# Copia este archivo a .env.local (no se sube a git) para desarrollo. En Vercel, las mismas variables se
# escriben en Project → Settings → Environment Variables.

# --- El modelo incluido ---------------------------------------------------------------------------
# Sky llega funcionando: nadie tiene que pegar una llave para empezar.
#
# EN VERCEL (o cualquier servidor): usa GROQ_API_KEY, SIN el prefijo VITE_. La llave se queda en el
# servidor y el navegador habla con /api/ai, así que nadie puede leerla desde la página.
GROQ_API_KEY=

# EN LOCAL (npm run dev, sin servidor de funciones): VITE_GROQ_KEY viaja en el paquete del navegador.
# Sirve para desarrollar y nada más: `npm run build` la deja fuera a propósito, porque cualquiera podría leerla
# en el JavaScript publicado. El paquete compilado usa /api/ai con GROQ_API_KEY.
VITE_GROQ_KEY=

# Fuerza el relevo /api/ai aunque haya VITE_GROQ_KEY (útil con `vercel dev`).
VITE_AI_PROXY=

# --- Cuentas -------------------------------------------------------------------------------------
# Con estas dos, la cuenta es tuya en cualquier dispositivo; los archivos siguen en el navegador que los hizo.
# Sin ellas, SkyOS usa perfiles locales: nombre, correo y PIN opcional, solo en este navegador. Ambas son
# públicas por diseño (la URL del proyecto y su llave publicable), así que van con prefijo VITE_.
#
# Dos formas de entrar, según lo que pueda hacer el despliegue:
#   · Sin SMTP propio (lo normal al empezar): correo y CONTRASEÑA. En Supabase → Authentication → Sign In /
#     Providers → Email: encendido y "Confirm email" APAGADO. Si queda encendido nadie podría entrar (el correo de
#     confirmación solo le llega al dueño del proyecto); SkyOS lo detecta al arrancar y sigue con perfiles locales
#     hasta que se apague, sin redesplegar. Sube "Minimum password length" a 8. Sin correo no hay recuperación de
#     contraseña, y la pantalla lo dice.
#   · Con SMTP propio (Resend u otro) en Authentication → Emails → SMTP Settings: pon VITE_ACCOUNTS_MAIL=1 y
#     entrar pasa a ser correo + código de seis dígitos, con el correo verificado. Enciende "Confirm email", pega
#     supabase/templates/magic-link.html en Emails → Magic Link ({{ .Token }} es el código), y en URL Configuration
#     pon Site URL y Redirect URLs con el origen donde sirves SkyOS. Las cuentas creadas con contraseña siguen valiendo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ACCOUNTS_MAIL=

# Para desarrollar sin proyecto real hay un doble de prueba (no es Supabase y no es seguro):
#   node tools/fake-accounts.mjs
#   VITE_SUPABASE_URL=http://localhost:54321 VITE_SUPABASE_ANON_KEY=lo-que-sea npm run dev

# --- Apps conectadas (MCP) -----------------------------------------------------------------------
# Las apps se conectan por el estándar MCP con la autorización OAuth del propio protocolo: no hacen falta
# llaves. Estas variables son opcionales.
# Origen público https donde se sirve SkyOS; permite identificarse con Client ID Metadata Documents.
VITE_APP_ORIGIN=
# Google (Drive, Docs, Gmail, Calendar) no registra clientes al vuelo: crea un cliente OAuth en
# https://console.cloud.google.com/apis/credentials con la URL de retorno <origen>/oauth/callback.
# Regístralo como "Aplicación de página única": usa PKCE y no necesita secreto.
VITE_GOOGLE_CLIENT_ID=
# Solo si tu cliente es del tipo "Aplicación web", que sí exige secreto. Ojo: esta variable viaja en el paquete
# del navegador, así que en un sitio público deja de ser secreta. Prefiere el cliente de página única.
VITE_GOOGLE_CLIENT_SECRET=
# Spotify, GitHub, Slack y Box tampoco registran clientes al vuelo (comprobado contra sus metadatos el 19-09-2026).
# Un registro por despliegue, siempre con la URL de retorno <origen>/oauth/callback, y conectar es un clic para
# todo el mundo; mientras no esté, la tarjeta de la app dice quién lo registra y el botón no promete.
#   · Spotify: https://developer.spotify.com/dashboard (acepta clientes públicos con PKCE; sin secreto).
#   · GitHub: https://github.com/settings/developers → OAuth App (exige secreto).
#   · Slack: https://api.slack.com/apps (exige secreto).
#   · Box: https://app.box.com/developers/console → app OAuth 2.0 (exige secreto).
# Los _SECRET con prefijo VITE_ viajan en el paquete del navegador: en un sitio público dejan de ser secretos.
VITE_SPOTIFY_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_CLIENT_SECRET=
VITE_SLACK_CLIENT_ID=
VITE_SLACK_CLIENT_SECRET=
VITE_BOX_CLIENT_ID=
VITE_BOX_CLIENT_SECRET=
# OneDrive: registro de aplicación en Microsoft Entra, tipo "Aplicación de página única", con la URI de
# redirección <origen>/oauth/callback y el permiso Files.ReadWrite.AppFolder.
VITE_MS_CLIENT_ID=

# Puente CORS para servidores MCP que no aceptan navegadores, y para GLM de Z.ai (que tampoco acepta
# llamadas directas desde el navegador). En un despliegue se sirve solo, en /api (MCP, OAuth y la IA que lo
# necesita: /api/ai/proxy); déjala vacía allí. En local apunta a la carpeta bridge/ (npm run bridge):
# http://127.0.0.1:8787
VITE_BRIDGE_URL=

# EN VERCEL, sin prefijo VITE_: el relevo de IA solo lleva la llave de la persona a los proveedores que rechazan
# navegadores (Z.ai ya está incluido). Si alojas SkyOS con otro así, añade su host aquí, coma separada.
AI_RELAY_HOSTS=
