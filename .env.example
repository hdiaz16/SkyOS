# Copia este archivo a .env.local (no se sube a git) para desarrollo. En Vercel, las mismas variables se
# escriben en Project → Settings → Environment Variables.

# --- El modelo incluido ---------------------------------------------------------------------------
# Sky llega funcionando: nadie tiene que pegar una llave para empezar.
#
# EN VERCEL (o cualquier servidor): usa GROQ_API_KEY, SIN el prefijo VITE_. La llave se queda en el
# servidor y el navegador habla con /api/ai, así que nadie puede leerla desde la página.
GROQ_API_KEY=

# EN LOCAL (npm run dev, sin servidor de funciones): VITE_GROQ_KEY viaja en el paquete del navegador.
# Sirve para desarrollar; no la pongas en un despliegue público.
VITE_GROQ_KEY=

# Fuerza el relevo /api/ai aunque haya VITE_GROQ_KEY (útil con `vercel dev`).
VITE_AI_PROXY=

# --- Apps conectadas (MCP) -----------------------------------------------------------------------
# Las apps se conectan por el estándar MCP con la autorización OAuth del propio protocolo: no hacen falta
# llaves. Estas variables son opcionales.
# Origen público https donde se sirve SkyOS; permite identificarse con Client ID Metadata Documents.
VITE_APP_ORIGIN=
# Google (Drive, Docs, Gmail, Calendar) no registra clientes al vuelo: crea un cliente OAuth "Aplicación web"
# en https://console.cloud.google.com/apis/credentials con la URL de retorno <origen>/oauth/callback.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
# OneDrive: registro de aplicación en Microsoft Entra, tipo "Aplicación de página única", con la URI de
# redirección <origen>/oauth/callback y el permiso Files.ReadWrite.AppFolder.
VITE_MS_CLIENT_ID=

# Puente CORS para servidores MCP que no aceptan navegadores. En un despliegue se sirve solo, en /api;
# déjala vacía allí. En local apunta a la carpeta bridge/ (npm run bridge): http://127.0.0.1:8787
VITE_BRIDGE_URL=
