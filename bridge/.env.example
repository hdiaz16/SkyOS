# Copia este archivo a .env (no se sube a git). El puente no guarda nada: no hay llaves de proveedores.

# Puerto donde escucha el puente (por defecto 8787).
PORT=8787
# Orígenes del navegador permitidos por CORS, separados por coma: el origen donde corre SkyOS.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# true para permitir destinos locales o privados (localhost, 127.x, 10.x, 192.168.x, 172.16-31.x, ::1), también por http. Solo para pruebas.
MCP_PROXY_ALLOW_LOCAL=false
